{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "prepare": "cd .. && husky",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .. --ignore-path .prettierignore --config .prettierrc.json",
    "format:check": "prettier --check .. --ignore-path .prettierignore --config .prettierrc.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "check:push": "pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@xyflow/react": "^13.0.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "husky": "^9.1.7",
    "prettier": "^3.8.2",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
